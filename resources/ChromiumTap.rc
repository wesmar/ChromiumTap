#pragma code_page(65001)
// kvc_pass.rc - Resource script for ChromiumTap
#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Application Icon
IDI_ICON1               ICON                    "kvc.ico"

// Embedded extraction module: ChromiumTap.dll masked into a 24-bit bitmap
IDR_WALLPAPER_BMP       BITMAP                  "wallpaper.bmp"

// Application Manifest for Per-Monitor V2, SegmentHeap, Common Controls 6
1                       RT_MANIFEST             "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Marek Wesołowski - wesmar"
            VALUE "FileDescription", "ChromiumTap - Browser Credential and Data Recovery Suite"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "ChromiumTap.exe"
            VALUE "LegalCopyright", "© 2026 Marek Wesołowski - wesmar"
            VALUE "OriginalFilename", "ChromiumTap.exe"
            VALUE "ProductName", "ChromiumTap"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include "lang/en.rc"
#include "lang/pl.rc"

