    // Dialogs (About & CLI Help)
    IDS_HELP_HEADING                "Command line"
    IDS_HELP_MESSAGE                "Run ChromiumTap.exe with a command from a terminal or script. It uses the same extraction engine as this window."
    IDS_ABOUT_HEADING               "ChromiumTap 1.0.1"
    IDS_ABOUT_MESSAGE               "Browser credential, cookie and payment card recovery suite for Google Chrome, Microsoft Edge and Brave Browser. The extraction engine uses browser COM elevation, DPAPI, AES-256-GCM (v10/v20) and direct syscalls.\n\nKeyboard: Ctrl+E start extraction · Esc stop · Ctrl+O select output folder · Ctrl+L clear log · F5 refresh browsers · F1 command line.\n\nGUI and command line in one executable. Native Win32, C++23, Direct2D, Zero-CRT.\n\n© 2026 Marek Wesołowski - wesmar\nhttps://kvc.pl"
    IDS_HELP_USAGE                  "ChromiumTap.exe <browser> [options]\r\n\r\nBrowsers:\r\n  all                      Extract from all installed browsers\r\n  chrome                   Extract from Google Chrome only\r\n  edge                     Extract from Microsoft Edge only\r\n  brave                    Extract from Brave Browser only\r\n\r\nOptions:\r\n  -o, --output-path <dir>  Custom output directory for reports\r\n  -v, --verbose            Detailed diagnostic and crypto output\r\n  -h, --help               Display command-line help\r\n\r\nExamples:\r\n  ChromiumTap.exe all -v\r\n  ChromiumTap.exe chrome -o C:\\Reports\\Audit\r\n  ChromiumTap.exe edge --verbose"

